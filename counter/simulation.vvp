#! /c/iverilog/bin/vvp
:ivl_version "0.9.7 " "(v0_9_7)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_011E38B8 .scope module, "counter_tb" "counter_tb" 2 1;
 .timescale 0 0;
v011A31E8_0 .var "clk", 0 0;
v011A3240_0 .net "out", 3 0, v011A3FC0_0; 1 drivers
v011AED80_0 .var "rstn", 0 0;
S_011A3EE0 .scope module, "uut" "counter" 2 5, 3 1, S_011E38B8;
 .timescale 0 0;
v011A3F68_0 .net "clk", 0 0, v011A31E8_0; 1 drivers
v011A3FC0_0 .var "out", 3 0;
v011A3190_0 .net "rstn", 0 0, v011AED80_0; 1 drivers
E_011E1C28/0 .event negedge, v011A3190_0;
E_011E1C28/1 .event posedge, v011A3F68_0;
E_011E1C28 .event/or E_011E1C28/0, E_011E1C28/1;
    .scope S_011A3EE0;
T_0 ;
    %wait E_011E1C28;
    %load/v 8, v011A3190_0, 1;
    %inv 8, 1;
    %jmp/0xz  T_0.0, 8;
    %ix/load 0, 4, 0;
    %assign/v0 v011A3FC0_0, 0, 0;
    %jmp T_0.1;
T_0.0 ;
    %ix/load 0, 1, 0;
    %load/vp0 8, v011A3FC0_0, 4;
    %ix/load 0, 4, 0;
    %assign/v0 v011A3FC0_0, 0, 8;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_011E38B8;
T_1 ;
    %delay 5, 0;
    %load/v 8, v011A31E8_0, 1;
    %inv 8, 1;
    %set/v v011A31E8_0, 8, 1;
    %jmp T_1;
    .thread T_1;
    .scope S_011E38B8;
T_2 ;
    %set/v v011A31E8_0, 0, 1;
    %set/v v011AED80_0, 0, 1;
    %delay 10, 0;
    %set/v v011AED80_0, 1, 1;
    %delay 10, 0;
    %set/v v011AED80_0, 0, 1;
    %delay 200, 0;
    %delay 5, 0;
    %set/v v011AED80_0, 1, 1;
    %delay 15, 0;
    %set/v v011AED80_0, 0, 1;
    %delay 20, 0;
    %vpi_call 2 23 "$finish";
    %end;
    .thread T_2;
    .scope S_011E38B8;
T_3 ;
    %vpi_call 2 27 "$monitor", "Time=%0t | rstn=%b | out=(Binary:%b)", $time, v011AED80_0, v011A3240_0;
    %vpi_call 2 28 "$dumpfile", "output.vcd";
    %vpi_call 2 29 "$dumpvars", 1'sb0, S_011E38B8;
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "counter_tb.v";
    "counter.v";
